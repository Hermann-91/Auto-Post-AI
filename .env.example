# Ambiente: dev | test | prod
APP_ENV=prod
APP_DOMAIN=app.seudominio.com
CORS_ORIGENS=["https://app.seudominio.com"]

# Segurança (gere chaves fortes antes de subir em produção)
# JWT: python -c "import secrets; print(secrets.token_urlsafe(48))"
# FERNET: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET_KEY=TROQUE_POR_CHAVE_ALEATORIA_MINIMO_32_CHARS
FERNET_KEYS=TROQUE_PELA_CHAVE_FERNET_BASE64
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Banco de Dados (PostgreSQL em prod/docker)
POSTGRES_DB=robo_auto_inst
POSTGRES_USER=robo_app
POSTGRES_PASSWORD=TROQUE_SENHA_FORTE_POSTGRES
DATABASE_URL=postgresql+asyncpg://robo_app:TROQUE_SENHA_FORTE_POSTGRES@db:5432/robo_auto_inst

# Redis (Rate Limit distribuído e locks/filas)
REDIS_PASSWORD=TROQUE_SENHA_FORTE_REDIS
REDIS_URL=redis://:TROQUE_SENHA_FORTE_REDIS@redis:6379/0

# Cloudflare Turnstile (Anti-Bot no Login/Registro)
CAPTCHA_ENABLED=true
TURNSTILE_SECRET_KEY=TROQUE_PELA_CHAVE_SECRETA_TURNSTILE

# Storage Principal em Nuvem (Cloudflare R2 / AWS S3)
STORAGE_BACKEND=s3
STORAGE_BUCKET=robo-auto-inst-midia
STORAGE_ENDPOINT_URL=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=TROQUE_ACCESS_KEY_R2
STORAGE_SECRET_ACCESS_KEY=TROQUE_SECRET_KEY_R2
STORAGE_PUBLIC_BASE_URL=https://cdn.seudominio.com
STORAGE_PRESIGNED_TTL_SEGUNDOS=3600

# Cotas padrão por conta Instagram (250 itens / 1 GB)
COTA_MAX_ITENS=250
COTA_MAX_BYTES=1073741824

# IA (OpenRouter: DeepSeek + Visão + Nano Banana) & Tendências Web
OPENROUTER_API_KEY=TROQUE_PELA_CHAVE_OPENROUTER
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELO_TEXTO_PADRAO=deepseek/deepseek-v4-flash
OPENROUTER_MODELO_TEXTO_FALLBACK=openrouter/free
OPENROUTER_MODELO_VISAO_PADRAO=google/gemini-2.5-flash-lite
OPENROUTER_MODELO_IMG_PADRAO=google/gemini-3.1-flash-image
TENDENCIAS_CACHE_TTL_HORAS=48
